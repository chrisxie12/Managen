# ── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── App ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
TENANT_BASE_URL=localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=replace-with-a-strong-32-char-secret
JWT_EXPIRES_IN=7d

# ── Authentication (Clerk) ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# ── Payments ─────────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
WEBHOOK_SECRET_SALT=replace-with-random-salt

# MTN MoMo
MOMO_API_USER=your-momo-api-user-uuid
MOMO_API_KEY=your-momo-api-key
MOMO_API_SECRET=your-momo-api-secret
MOMO_SUBSCRIPTION_KEY=your-momo-subscription-key
MOMO_ENVIRONMENT=sandbox

# ── Messaging ────────────────────────────────────────────────────────────────────
# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token

# Twilio (fallback SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Arkesel (Ghana SMS)
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_BASE_URL=https://sms.arkesel.com/sms/api
ARKESEL_SENDER_ID=SchoolOS
SMS_SENDER_ID=SchoolOS

# Mailgun (email)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=Managen <noreply@yourdomain.com>

# Fee reminder channel priority
FEE_REMINDER_CHANNEL_ORDER=whatsapp,sms,email

# ── AI ───────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key

# ── File Storage (DigitalOcean Spaces) ──────────────────────────────────────────
SPACES_KEY=your-do-spaces-access-key
SPACES_SECRET=your-do-spaces-secret-key
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_CDN_ENDPOINT=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
SPACES_BUCKET=your-bucket-name
SPACES_REGION=nyc3

# ── Push Notifications (VAPID) ───────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@getschoolos.me

# ── Monitoring ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DD_ENABLED=false

# ── Internal services ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
WORKER_SECRET=replace-with-random-worker-secret
CRON_SECRET=replace-with-random-cron-secret

# Message retry config
MESSAGE_MAX_RETRIES=3
MESSAGE_RETRY_BASE_MS=1000

# ── Super-admin seed (dev only) ──────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@getschoolos.me
SUPER_ADMIN_PASSWORD=changeme
DEMO_WEBHOOK_URL=
